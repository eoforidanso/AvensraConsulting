# ============================================================================
# Avensra Consulting — environment configuration
# Copy to .env.local for development. Set the same keys in your hosting
# provider's environment settings for production.
#
# Everything here belongs to ACCOUNTS OWNED BY AVENSRA. Developers should
# receive role-based access to those accounts, never ownership of them.
# ============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://avensraconsulting.com"

# Only set this when the site is served from a sub-path (the GitHub Pages
# preview is served from /AvensraConsulting). next/image does not apply
# basePath to src when images.unoptimized is set, so asset paths need it
# explicitly. Leave EMPTY for the real deployment at a domain root.
NEXT_PUBLIC_BASE_PATH=""

# --- Payments (Stripe) ------------------------------------------------------
# Live keys from the Avensra-owned Stripe account.
STRIPE_SECRET_KEY=""
# From Stripe Dashboard > Developers > Webhooks, for the endpoint
# https://avensraconsulting.com/api/stripe/webhook
# Subscribe it to: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs. Preferred over the hardcoded amounts, because it lets
# Avensra change prices from the Stripe dashboard without a code deploy.
STRIPE_PRICE_BPAS=""
STRIPE_PRICE_TER=""

# Display prices in USD CENTS. Must match the Stripe Prices above.
# PLACEHOLDERS — confirm with Avensra before launch.
NEXT_PUBLIC_PRICE_BPAS="49700"
NEXT_PUBLIC_PRICE_TER="3700"

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Avensra Consulting <info@avensraconsulting.com>"
MAIL_TO="info@avensraconsulting.com"

# --- Secure delivery --------------------------------------------------------
# Signs access tokens. Generate with: openssl rand -base64 48
# REQUIRED in production. Rotating this invalidates all outstanding links.
DELIVERY_SECRET=""

# Where protected product files live. Must NOT be inside /public.
PROTECTED_DIR="./protected"

# --- Admin export screen ----------------------------------------------------
# Shared password for /admin. Use a long random string.
ADMIN_PASSWORD=""

# --- DRM / licensing --------------------------------------------------------
# "none" until a provider is selected at UAT. Set to "locklizard" to activate
# that adapter. While unset, the site issues signed expiring access links so
# the full purchase-to-access journey stays testable.
LICENSING_PROVIDER="none"
LOCKLIZARD_API_URL=""
LOCKLIZARD_API_KEY=""
LOCKLIZARD_ACCOUNT_ID=""

# --- Storage ----------------------------------------------------------------
# Leave blank to use file storage under ./data (fine for local development).
# Set a Postgres URL for production — required on serverless hosting, where
# the filesystem is ephemeral and form submissions would otherwise be lost.
DATABASE_URL=""
DATA_DIR="./data"

# --- Analytics and marketing tags -------------------------------------------
# Each tag stays completely dormant until its ID is set.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
